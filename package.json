{
  "name": "ritesdev-ecosystem",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync": "node scripts/sync-sites.mjs",
    "predev": "npm run sync",
    "prebuild": "npm run sync",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "app": "npm --prefix devApps/ritesDevApp start",
    "devapps": "npm --prefix devApps/ritesDevApp start",
    "tunnel": "npm run build && concurrently \"HOST=127.0.0.1 PORT=4321 node dist/server/entry.mjs\" \"cloudflared tunnel run astro-site-tunnel\"",
    "tunnel:restart": "pkill -f cloudflared || true && npm run tunnel",
    "mgmt:status": "node scripts/management/status.mjs",
    "mgmt:content": "node scripts/management/content-inventory.mjs",
    "mgmt:apps": "node scripts/management/list-apps.mjs",
    "mgmt:setup": "node scripts/management/setup-check.mjs",
    "discord:setup": "node scripts/discord/setup.mjs",
    "docs:check": "node --test scripts/test/docs.test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/node": "^11.1.6",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.1",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8"
  },
  "allowScripts": {
    "esbuild": true
  }
}
