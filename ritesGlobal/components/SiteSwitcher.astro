---
import { listSites } from "../sites.registry.mjs";

const sites = listSites();
const currentPath = Astro.url.pathname;

function isActive(basePath: string) {
	if (basePath === "/") return currentPath === "/";
	return currentPath === basePath || currentPath.startsWith(`${basePath}/`);
}
---

<div class="site-switcher">
	<button class="site-switcher__toggle" type="button" aria-haspopup="true" aria-expanded="false">
		<span>Sites</span>
		<span class="site-switcher__caret" aria-hidden="true">&#9662;</span>
	</button>
	<ul class="site-switcher__menu" role="menu">
		{sites.map((site) => (
			<li role="none">
				<a role="menuitem" href={site.basePath} class={isActive(site.basePath) ? "active" : ""}>
					{site.label}
				</a>
			</li>
		))}
	</ul>
</div>

<script>
	document.querySelectorAll(".site-switcher").forEach((switcher) => {
		const toggle = switcher.querySelector(".site-switcher__toggle");
		toggle?.addEventListener("click", (event) => {
			event.stopPropagation();
			const expanded = toggle.getAttribute("aria-expanded") === "true";
			toggle.setAttribute("aria-expanded", String(!expanded));
			switcher.classList.toggle("is-open", !expanded);
		});
	});
	document.addEventListener("click", (event) => {
		document.querySelectorAll(".site-switcher.is-open").forEach((switcher) => {
			if (!switcher.contains(event.target as Node)) {
				switcher.classList.remove("is-open");
				switcher.querySelector(".site-switcher__toggle")?.setAttribute("aria-expanded", "false");
			}
		});
	});
	document.addEventListener("keydown", (event) => {
		if (event.key !== "Escape") return;
		document.querySelectorAll(".site-switcher.is-open").forEach((switcher) => {
			switcher.classList.remove("is-open");
			switcher.querySelector(".site-switcher__toggle")?.setAttribute("aria-expanded", "false");
		});
	});
</script>

<style>
	.site-switcher {
		position: relative;
		display: inline-block;
	}
	.site-switcher__toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		background: transparent;
		border: 1px solid var(--color-border, rgba(128, 128, 128, 0.4));
		color: inherit;
		padding: 0.35rem 0.7rem;
		border-radius: 4px;
		font: inherit;
		font-size: 0.85rem;
		cursor: pointer;
	}
	.site-switcher__caret {
		font-size: 0.7rem;
		transition: transform 0.15s ease;
	}
	.site-switcher.is-open .site-switcher__caret {
		transform: rotate(180deg);
	}
	.site-switcher__menu {
		position: absolute;
		top: calc(100% + 0.4rem);
		right: 0;
		margin: 0;
		padding: 0.35rem;
		list-style: none;
		min-width: 9rem;
		background: var(--color-bg-secondary, #1c1c1e);
		border: 1px solid var(--color-border, rgba(128, 128, 128, 0.4));
		border-radius: 0.6rem;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
		display: none;
		z-index: 100;
	}
	.site-switcher.is-open .site-switcher__menu {
		display: block;
	}
	.site-switcher__menu a {
		display: block;
		padding: 0.4rem 0.6rem;
		border-radius: 0.4rem;
		text-decoration: none;
		color: inherit;
		font-size: 0.85rem;
	}
	.site-switcher__menu a:hover,
	.site-switcher__menu a.active {
		background: var(--color-accent, #5865f2);
		color: #fff;
	}
</style>
