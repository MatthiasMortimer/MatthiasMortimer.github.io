---
// Shared <head> SEO partial for every site's BaseLayout: canonical URL, Open Graph/Twitter
// tags, robots directive, and Person JSON-LD (Matt / RitesDev), all driven by ritesGlobal/seo.json + contact.json.
import { seoDefaults } from "../seo.js";
import { identity } from "../content.js";

export interface Props {
	title: string;
	description: string;
	image?: string;
	type?: "website" | "article";
	noindex?: boolean;
	// "business" presents the person as RitesDev; "personal" as Matt, a.k.a. RitesDev.
	persona?: "business" | "personal";
}

const { title, description, image = seoDefaults.defaultImage, type = "website", noindex = false, persona = "business" } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const shouldIndex = !noindex && seoDefaults.robotsIndex;
const shouldFollow = !noindex && seoDefaults.robotsFollow;

const personLd = {
	"@context": "https://schema.org",
	"@type": seoDefaults.organizationType,
	name: persona === "personal" ? identity.personalName : identity.name,
	alternateName: persona === "personal" ? identity.name : identity.personalName,
	...(persona === "personal" && { worksFor: { "@type": "Organization", name: identity.name } }),
	jobTitle: identity.title,
	url: canonicalURL.toString(),
	image: imageURL.toString(),
	email: identity.email,
	sameAs: Object.values(identity.socials || {}).filter(Boolean),
};
---

<link rel="canonical" href={canonicalURL} />
<meta name="description" content={description} />
<meta name="robots" content={`${shouldIndex ? "index" : "noindex"}, ${shouldFollow ? "follow" : "nofollow"}`} />
<meta name="theme-color" content={seoDefaults.themeColor} />

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={imageURL} />
<meta property="og:site_name" content={seoDefaults.siteName} />
<meta property="og:locale" content={seoDefaults.locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
{seoDefaults.twitterHandle && <meta name="twitter:site" content={seoDefaults.twitterHandle} />}

<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
