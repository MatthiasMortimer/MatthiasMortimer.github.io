---
import "../styles/global.css";
import { identity } from "@const/identity.js";
import SiteSwitcher from "@ritesGlobal/components/SiteSwitcher.astro";

const { currentPath = Astro.url.pathname } = Astro;
---

<nav class="site-nav" aria-label="Main navigation">
	<a class="site-nav__brand" href="/">
		<img src={identity.logo} alt="" width="38" height="38" />
		<span>{identity.name}</span>
	</a>
	<div class="site-nav__links">
		<a href="/" class={currentPath === "/" ? "active" : ""}>Home</a>
		<a href="/services/" class={currentPath === "/services/" || currentPath === "/services" ? "active" : ""}>Services & Teaching</a>
		<a href="/portfolio/" class={currentPath === "/portfolio/" || currentPath === "/portfolio" ? "active" : ""}>Portfolio</a>
		<a href="/about/" class={currentPath === "/about/" || currentPath === "/about" ? "active" : ""}>About</a>
		<a href="/contact/" class={currentPath === "/contact/" || currentPath === "/contact" ? "active" : ""}>Contact</a>
		<a href="/contact/" class="btn btn-primary btn-sm">Hire / Book</a>
		<SiteSwitcher />
	</div>
</nav>
