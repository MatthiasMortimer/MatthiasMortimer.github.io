---
import { identity } from "@ritesGlobal/content.js";
import SharedSiteNav from "@ritesGlobal/components/SiteNav.astro";
import site from "../content/site.json";

const currentPath = Astro.url.pathname;
---

<SharedSiteNav
	siteName={site.name}
	navigation={site.navigation}
	currentPath={currentPath}
	brandHref="/"
	logoSrc={identity.logo}
	primaryAction={site.primaryAction}
	theme="ritesdev"
/>
