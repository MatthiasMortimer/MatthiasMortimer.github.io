---
import SiteNav from "../components/SiteNav.astro";
import Footer from "../components/Footer.astro";
import SeoMeta from "@ritesGlobal/components/SeoMeta.astro";
import site from "../content/site.json";

export interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
}

const { title = site.metadata.title, description = site.metadata.description, image, noindex } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<SeoMeta title={title} description={description} image={image} noindex={noindex} />
	</head>
	<body>
		<SiteNav />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
