---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { tags as sharedTags, normalizeTags } from "@ritesGlobal/tags.js";
import type { MDXInstance } from "astro";
import { frontmatter as page } from "../content/pages/blog.md";

interface PostFrontmatter {
	title?: string;
	pubDate?: Date | string;
	tags?: string[];
	description?: string;
}

const postModules = import.meta.glob<MDXInstance<PostFrontmatter>>("../content/posts/*.mdx", { eager: true });
const posts = Object.entries(postModules)
	.map(([filePath, { frontmatter }]) => {
		const slug = filePath.split("/").at(-1)?.replace(/\.mdx$/, "") || "";
		const date = frontmatter.pubDate ? new Date(frontmatter.pubDate).toISOString().slice(0, 10) : "";
		return {
			title: frontmatter.title || slug,
			href: `/blog/posts/${slug}/`,
			date,
			tags: normalizeTags(frontmatter.tags),
			description: frontmatter.description || "",
		};
	})
	.sort((first, second) => second.date.localeCompare(first.date));
const usedTags = new Set(posts.flatMap((post) => post.tags));
const tags = sharedTags.filter((tag) => usedTags.has(tag));
---

<BaseLayout title={page.seo.title} description={page.seo.description}>
	<h1>{page.title}</h1>
	<p>{page.description}</p>

	<div class="tag-filter" aria-label="Filter posts by tag">
		<button class="tag-filter__button is-active" type="button" data-tag-filter="all">{page.allTagsLabel}</button>
		{tags.map((tag) => (
			<button class="tag-filter__button" type="button" data-tag-filter={tag}>{tag}</button>
		))}
	</div>

	<section class="post-grid" aria-label={page.postsLabel}>
		{posts.map((post) => <PostCard {...post} />)}
	</section>

	<script>
		const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-tag-filter]");
		const postCards = document.querySelectorAll<HTMLElement>(".post-card");

		filterButtons.forEach((button) => {
			button.addEventListener("click", () => {
				const selectedTag = button.dataset.tagFilter;

				filterButtons.forEach((filterButton) => {
					filterButton.classList.toggle("is-active", filterButton === button);
				});

				postCards.forEach((postCard) => {
					const cardTags = (postCard.dataset.tags || "").split(",");
					postCard.hidden = selectedTag !== "all" && !cardTags.includes(selectedTag || "");
				});
			});
		});
	</script>
</BaseLayout>