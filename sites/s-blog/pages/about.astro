---
import { projects } from "@ritesGlobal/projects.js";
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../content/site.json";
import { frontmatter as page } from "../content/pages/about.md";

const { identity } = site;
const intro = page.intro
	.replace("{firstName}", identity.firstName)
	.replace("{occupation}", identity.occupation)
	.replace("{country}", identity.country);
const hobbies = page.hobbies.replace("{hobbies}", identity.hobbies.join(", "));
---

<BaseLayout title={page.seo.title} description={page.seo.description}>
	<h1>{page.title}</h1>
	<p>{intro}</p>
	<p>{hobbies}</p>

	<section class="projects" aria-labelledby="projects-title">
		<h2 id="projects-title">{page.projectsTitle}</h2>
		<ul>
			{projects.map((project) => (
				<li>
					<strong>{project.name}</strong>
					<p>{project.description}</p>
				</li>
			))}
		</ul>
	</section>
</BaseLayout>