---
import { happy, finished, goal } from "@blog/const/identity.js";
import { projects } from "@ritesGlobal/projects.js";
import skills from "@blog/const/skills.json";
import SiteNav from "../components/SiteNav.astro";
--- 

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>About - Blog Rites</title>
	</head>
	<body>
	<SiteNav />

        <h1>Security Rites</h1>
	</body>
	<p> 
				Through this blog, I hope to document my journey, share insights, and connect with others who are passionate about security. <br /> 
	</p>

	<section class="projects" aria-labelledby="projects-title">
		<h2 id="projects-title">Current Projects</h2>
		<ul>
			{projects.map((project) => (
				<li>
					<strong>{project.name}</strong>
					<p>{project.description}</p>
				</li>
			))}
		</ul>
	</section>

</html>