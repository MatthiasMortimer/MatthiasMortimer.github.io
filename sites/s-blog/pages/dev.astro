---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteVersion, gitversion } from "@ritesGlobal/versions.js";
import site from "../content/site.json";
import { frontmatter as page } from "../content/pages/dev.md";

const siteStats = {
	siteName: site.name,
	posts: site.stats.posts,
	version: getSiteVersion("blog"),
	gitversion,
	lastUpdated: site.stats.lastUpdated,
};
---

<BaseLayout title={page.seo.title} description={page.seo.description}>
	<h1>{page.title}</h1>
	<ul>
		{Object.entries(siteStats)
			.map(([label, value]) => (
			<li><strong>{label}:</strong> {value}</li>
			))}
	</ul>
	<p>{page.description}</p>
</BaseLayout>