---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import BlogFooter from "../components/BlogFooter.astro";
import HomeInfoCard from "../components/HomeInfoCard.astro";
import type { MDXInstance } from "astro";
import { normalizeTags } from "@ritesGlobal/tags.js";
import { projects } from "@ritesGlobal/projects.js";
import site from "../content/site.json";
import { frontmatter as page } from "../content/pages/index.md";
import { frontmatter as about } from "../content/pages/about.md";
import homeInfo from "../content/home-info.json";

const { identity } = site;
interface PostFrontmatter {
	title?: string;
	pubDate?: Date | string;
	tags?: string[];
	description?: string;
}

const postModules = import.meta.glob<MDXInstance<PostFrontmatter>>("../content/posts/*.mdx", { eager: true });
const latestPosts = Object.entries(postModules)
	.map(([filePath, { frontmatter }]) => {
		const slug = filePath.split("/").at(-1)?.replace(/\.mdx$/, "") || "";
		const date = frontmatter.pubDate ? new Date(frontmatter.pubDate).toISOString().slice(0, 10) : "";
		return {
			title: frontmatter.title || slug,
			href: `/blog/posts/${slug}/`,
			date,
			tags: normalizeTags(frontmatter.tags),
			description: frontmatter.description || "",
		};
	})
	.sort((first, second) => second.date.localeCompare(first.date))
	.slice(0, 3);
const aboutIntro = about.intro
	.replace("{firstName}", identity.firstName)
	.replace("{occupation}", identity.occupation)
	.replace("{country}", identity.country);
const hobbies = about.hobbies.replace("{hobbies}", identity.hobbies.join(", "));
---

<BaseLayout title={page.seo.title} description={page.seo.description} homeLayout>
	<div class="home-layout">
		<HomeInfoCard title={homeInfo.title}>
			{homeInfo.body && <p>{homeInfo.body}</p>}
		</HomeInfoCard>
		<HomeInfoCard title={about.title} about>
			<p>{aboutIntro}</p>
			<p>{hobbies}</p>
		</HomeInfoCard>
		<div class="home-content" role="region" aria-label="Latest posts and projects" tabindex="0">
			<section aria-labelledby="latest-title">
				<div class="section-heading">
					<h1 id="latest-title" data-scroll-reveal>{page.latest.title}</h1>
					<a href="/blog/blog/">{page.latest.link}</a>
				</div>
				<div class="post-grid">
					{latestPosts.map((post) => <PostCard {...post} />)}
				</div>
			</section>

			<section class="projects" aria-labelledby="projects-title">
				<h2 id="projects-title" data-scroll-reveal>{about.projectsTitle}</h2>
				<ul>
					{projects.map((project) => (
						<li data-scroll-reveal>
							<strong>{project.title}</strong>
							<p>{project.description}</p>
						</li>
					))}
				</ul>
			</section>
			<BlogFooter />
		</div>
	</div>
	<script>
		import "../scripts/home-cards.js";
	</script>
</BaseLayout>
