---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import type { MDXInstance } from "astro";
import { normalizeTags } from "@ritesGlobal/tags.js";
import site from "../content/site.json";
import { frontmatter as page } from "../content/pages/index.md";

const { identity } = site;
interface PostFrontmatter {
	title?: string;
	pubDate?: Date | string;
	tags?: string[];
	description?: string;
}

const postModules = import.meta.glob<MDXInstance<PostFrontmatter>>("../content/posts/*.mdx", { eager: true });
const latestPosts = Object.entries(postModules)
	.map(([filePath, { frontmatter }]) => {
		const slug = filePath.split("/").at(-1)?.replace(/\.mdx$/, "") || "";
		const date = frontmatter.pubDate ? new Date(frontmatter.pubDate).toISOString().slice(0, 10) : "";
		return {
			title: frontmatter.title || slug,
			href: `/blog/posts/${slug}/`,
			date,
			tags: normalizeTags(frontmatter.tags),
			description: frontmatter.description || "",
		};
	})
	.sort((first, second) => second.date.localeCompare(first.date))
	.slice(0, 3);
const heroTitle = page.hero.title.replace("{firstName}", identity.firstName);
const heroDescription = page.hero.description.replace("{occupation}", identity.occupation);
---

<BaseLayout title={page.seo.title} description={page.seo.description}>
	<section class="hero">
		<span class="hero__eyebrow">{page.hero.eyebrow}</span>
		<h1>{heroTitle}</h1>
		<p>{heroDescription}</p>
	</section>

	<section aria-labelledby="latest-title">
		<div class="section-heading">
			<h2 id="latest-title">{page.latest.title}</h2>
			<a href="/blog/blog/">{page.latest.link}</a>
		</div>
		<div class="post-grid">
			{latestPosts.map((post) => <PostCard {...post} />)}
		</div>
	</section>
</BaseLayout>
