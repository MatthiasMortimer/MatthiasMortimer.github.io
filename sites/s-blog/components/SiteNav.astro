---
import SharedSiteNav from "@ritesGlobal/components/SiteNav.astro";
import { media } from "@ritesGlobal/content.js";
import site from "../content/site.json";

const currentPath = Astro.url.pathname;
---

<SharedSiteNav
	siteName={site.name}
	navigation={site.navigation}
	currentPath={currentPath}
	brandHref="/blog/"
	logoSrc={media.blogLogo}
	logoWidth={48}
	logoHeight={48}
	theme="blog"
/>
