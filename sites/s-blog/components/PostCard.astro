---
export interface Props {
	title: string;
	href: string;
	date: string;
	tags: string[];
	description: string;
}

const { title, href, date, tags = [], description } = Astro.props;
---

<article class="post-card" data-tags={tags.join(",")}>
	<a class="post-card__link" href={href}>
		<div>
			<p class="post-card__date">{date}</p>
			<h2>{title}</h2>
			{tags.length > 0 && <p class="post-card__tag">{tags.join(" · ")}</p>}
			<p>{description}</p>
		</div>
		<span class="post-card__arrow" aria-hidden="true">-&gt;</span>
	</a>
</article>
